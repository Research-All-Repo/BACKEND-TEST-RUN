# AquaCast edge settings. install.sh copies this to /etc/aquacast/edge.env (readable only by
# root and the aquacast service). Edit there with:  sudo nano /etc/aquacast/edge.env
# then:  sudo systemctl restart aquacast-edge

# ---- connection --------------------------------------------------------------------------
AQUACAST_SERVER_URL=https://aquacast-research.vercel.app
# The SAME value as EDGE_API_KEY in Vercel. Never post it in chat, screenshots or GitHub.
AQUACAST_EDGE_KEY=

# ---- sensors -----------------------------------------------------------------------------
# real = the group's driver (hardware/aquacast_hardware_pd1.py); demo = fake readings for testing
AQUACAST_SENSOR_MODE=real
# same settings as aquacast_logger.py (--port, --baud, --light-address, --do-address)
AQUACAST_SERIAL_PORT=/dev/ttyUSB0
AQUACAST_BAUD=9600
AQUACAST_LIGHT_ADDRESS=1
AQUACAST_DO_ADDRESS=2
# 0 = pH board deliberately disconnected (its readings are stored as MISSING)
AQUACAST_PH_ENABLED=1
# seconds to wait after start-up before the first reading (logger --warmup)
AQUACAST_WARMUP_SECONDS=60
# demo mode only: lower the fake DO by this many mg/L to test alerts (5 = Critical). Keep 0 otherwise.
AQUACAST_DEMO_DO_SHIFT=0

# ---- aerator relay (BCM GPIO numbers, not physical pin numbers) -----------------------------
# Leave empty to run without a relay (switching is only logged).
AQUACAST_RELAY_PIN=
# most cheap relay boards switch ON with a LOW signal -> false
AQUACAST_RELAY_ACTIVE_HIGH=false
# true  = aerator on the relay's NO contact (aerator runs only while the Pi energizes the relay)
# false = aerator on the NC contact: if the Pi crashes or loses power the aerator RUNS (fail-safe)
AQUACAST_RELAY_ON_WHEN_ENERGIZED=true
# AUTOMATIC mode keeps the aerator ON at least this long before switching OFF again
AQUACAST_AUTO_MIN_ON_MINUTES=20

# ---- optional local buzzer for CRITICAL (works without internet) ---------------------------
AQUACAST_BUZZER_PIN=
AQUACAST_BUZZER_SECONDS=30

# ---- forecast model (shown in the dashboard's Model Evaluation) ------------------------------
# Path of the trained model file. Empty = built-in placeholder forecaster.
AQUACAST_MODEL_FILE=
# Different file per horizon? Use these instead (any you leave empty use AQUACAST_MODEL_FILE):
# AQUACAST_MODEL_FILE_30=
# AQUACAST_MODEL_FILE_60=
# AQUACAST_MODEL_FILE_90=
# AQUACAST_MODEL_FILE_120=
AQUACAST_MODEL_NAME=AquaCast DO forecaster
AQUACAST_MODEL_ALGORITHM=Persistence with damped trend (placeholder until the trained model is installed)
AQUACAST_MODEL_VERSION=baseline-1
AQUACAST_MODEL_TRAINING_START=2026-01-01T00:00:00Z
AQUACAST_MODEL_TRAINING_END=2026-01-01T00:00:00Z

# ---- rarely changed --------------------------------------------------------------------------
AQUACAST_DATA_DIR=/var/lib/aquacast
AQUACAST_CYCLE_MINUTES=10
AQUACAST_CONTROL_POLL_SECONDS=15
AQUACAST_UPLOAD_BATCH=20
AQUACAST_KEEP_DAYS=90
AQUACAST_LOG_LEVEL=INFO
