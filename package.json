{
  "name": "aquacast-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AquaCast dashboard backend: Supabase Auth sessions, dashboard API, aerator command requests, mock edge simulator",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed-mock-data.js",
    "simulate": "node scripts/run-edge-simulator.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "build:dark": "node scripts/build-dark-theme.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  }
}
