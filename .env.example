# Copy to .env for local development. NEVER commit .env.
# Supabase -> Project Settings -> API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret: bypasses Row Level Security. Server only. Never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the site (Vercel: https://your-project.vercel.app). Used in email links.
PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
COOKIE_SECURE=false

# Data freshness thresholds (minutes) for the 10-minute cycle
SYNC_DELAYED_AFTER_MINUTES=25
EDGE_OFFLINE_AFTER_MINUTES=60
AERATOR_REPORT_STALE_MINUTES=20
AERATOR_COMMAND_TTL_SECONDS=120

# Real Raspberry Pi: shared key for /api/edge (at least 32 random characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Put the SAME value in Vercel and in /etc/aquacast/edge.env on the Pi. Never commit it.
EDGE_API_KEY=

# Simulated Raspberry Pi (mock data). Turn off when the real edge device syncs.
MOCK_EDGE_ENABLED=true
MOCK_EDGE_TICK_SECONDS=30
MOCK_EDGE_BACKFILL_HOURS=24
MOCK_EDGE_ACK_DELAY_SECONDS=15
# background = timer in a long-running server (local / Render); on-request = serverless (automatic on Vercel)
# MOCK_EDGE_MODE=background
# On-request mode: minimum seconds between catch-up ticks
MOCK_EDGE_MIN_INTERVAL_SECONDS=20

# Integration tests (npm test) - use a TEST project, not production
TEST_BASE_URL=http://localhost:3000
TEST_ADMIN_EMAIL=admin@aquacast.test
TEST_ADMIN_PASSWORD=change-me-long-password

# --- Instant phone alerts (Web Push) ---
# Generate locally with: npx web-push generate-vapid-keys   (never commit or share the private key)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# must start with "mailto:" (a bare email is fixed automatically)
VAPID_SUBJECT=mailto:you@example.com

# Contact shown on the Privacy Notice page for data-privacy requests
PRIVACY_CONTACT_EMAIL=
# optional alert tuning
# ESCALATE_AFTER_MINUTES=15
# CALIBRATION_DEFAULT_HOURS=2
# Random secret shared with the Supabase Database Webhook (header x-aquacast-hook-secret)
PUSH_HOOK_SECRET=
PUSH_CRITICAL_REMINDER_MINUTES=30
