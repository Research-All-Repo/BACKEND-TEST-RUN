# Copy to .env for local development. NEVER commit .env.
# Supabase -> Project Settings -> API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret: bypasses Row Level Security. Server only. Never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the site (Vercel: https://your-project.vercel.app). Used in email links.
PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
COOKIE_SECURE=false

# Data freshness thresholds (minutes) for the 10-minute cycle
SYNC_DELAYED_AFTER_MINUTES=25
EDGE_OFFLINE_AFTER_MINUTES=60
AERATOR_REPORT_STALE_MINUTES=20
AERATOR_COMMAND_TTL_SECONDS=120

# Simulated Raspberry Pi (mock data). Turn off when the real edge device syncs.
MOCK_EDGE_ENABLED=true
MOCK_EDGE_TICK_SECONDS=30
MOCK_EDGE_BACKFILL_HOURS=24
MOCK_EDGE_ACK_DELAY_SECONDS=15
# background = timer in a long-running server (local / Render); on-request = serverless (automatic on Vercel)
# MOCK_EDGE_MODE=background
# On-request mode: minimum seconds between catch-up ticks
MOCK_EDGE_MIN_INTERVAL_SECONDS=20

# Integration tests (npm test) - use a TEST project, not production
TEST_BASE_URL=http://localhost:3000
TEST_ADMIN_EMAIL=admin@aquacast.test
TEST_ADMIN_PASSWORD=change-me-long-password
